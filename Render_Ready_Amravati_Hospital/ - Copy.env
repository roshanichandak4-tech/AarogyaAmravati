# JWT Secret Key
JWT_SECRET=amravati_hospital_jwt_secret_key_2026

# Google Gemini API Key (Optional: for chatbot integration)
GEMINI_API_KEY=

# TWILIO SMS GATEWAY (Add details below to receive real SMS notifications on your mobile phone!)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
